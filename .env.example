COMPOSE_PROJECT_NAME=amar-assist

# Public URLs served by nginx
APP_URL=http://localhost
FRONTEND_URL=http://localhost
NGINX_PORT=80

# MySQL
MYSQL_DATABASE=amar_assist
MYSQL_USER=amar
MYSQL_PASSWORD=secret
MYSQL_ROOT_PASSWORD=secret
MYSQL_PORT=3306

# Redis
REDIS_PORT=6379

# Vue (baked into the frontend image at build time)
VITE_APP_NAME="Amar Assist"
VITE_API_URL=/api
